# Copy to .env and fill in. NEVER commit .env.

# Neon Postgres connection string (pooled endpoint, sslmode=require)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Optional. When set, every request except /health must send a matching
# X-RapidAPI-Proxy-Secret header. Leave unset for local development.
RAPIDAPI_PROXY_SECRET=

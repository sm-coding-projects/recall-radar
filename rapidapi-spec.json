    "/recalls/search": {
      "get": {
        "tags": [
          "recalls"
        ],
        "summary": "Full-text search over recalls",
        "description": "Postgres full-text search across product name, brand, and hazard text.\n\nResults are ranked by relevance, then by recall date.\n\nSupports web-search style operators:\n\n| Query | Meaning |\n|---|---|\n| `listeria cheese` | both words |\n| `\"air bag\"` | exact phrase |\n| `\"air bag\" -inflator` | phrase, excluding a term |\n| `salmonella or listeria` | either word |\n\nMatching is stemmed English, so `recalled` also matches `recall`.\nPunctuation and stray operators are handled gracefully rather than\nreturning an error.\n\nSearching is the right tool for \"is this product recalled?\"; use\n`/recalls` when you want to browse or export a date range.\n\n`agency`, `page`, and `per_page` may be sent blank, which means \"not\nsupplied\". `q` is required: an empty query returns `422`.",
        "operationId": "searchRecalls",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 2,
              "description": "Search query. Required, minimum 2 characters.",
              "examples": [
                "listeria"
              ],
              "title": "Q"
            },
            "description": "Search query. Required, minimum 2 characters."
          },
          {
            "name": "agency",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Optionally restrict to one agency. Blank means all agencies.",
              "examples": [
                "FDA"
              ],
              "title": "Agency"
            },
            "description": "Optionally restrict to one agency. Blank means all agencies."
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ],
              "description": "1-based page number. Blank defaults to 1.",
              "examples": [
                1
              ],
              "title": "Page"
            },
            "description": "1-based page number. Blank defaults to 1."
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer",
                  "maximum": 100,
                  "minimum": 1
                },
                {
                  "type": "null"
                }
              ],
              "description": "Results per page, max 100. Blank defaults to 25.",
              "examples": [
                25
              ],
              "title": "Per Page"
            },
            "description": "Results per page, max 100. Blank defaults to 25."
          }
        ],
        "responses": {
          "200": {
            "description": "Recalls matching the query, most relevant first.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListResponse_Recall_"
                },
                "example": {
                  "data": [
                    {
                      "id": 100,
                      "agency": "FDA",
                      "source_id": "D-0690-2026",
                      "product": "BD ChloraPrep Clear, (2% w/v chlorhexidine gluconate (CHG) and 70% v/v isopropyl alcohol), 60 x 1 mL applicators/carton, STERILE SOLUTION, CareFusion 123, LLC, El Paso, TX. NDC 54365-400-31",
                      "brand": "CareFusion 213, LLC",
                      "category": "Drugs",
                      "hazard": "Lack of Assurance of Sterility: Affected product may exhibit an open or incomplete seal on the packaging of the applicator",
                      "classification": "Class II",
                      "recall_date": "2026-07-09",
                      "published_at": "2026-07-22T00:00:00Z",
                      "url": "https://www.fda.gov/safety/recalls-market-withdrawals-safety-alerts",
                      "ingested_at": "2026-07-31T04:07:23.113838Z"
                    }
                  ],
                  "pagination": {
                    "page": 1,
                    "per_page": 25,
                    "total": 7498,
                    "total_pages": 300,
                    "has_next": true,
                    "has_prev": false
                  },
                  "meta": {
                    "query": "listeria"
                  }
                }
              }
            }
          },
          "422": {
            "description": "A parameter failed validation, e.g. per_page above 100 or a malformed date.",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "invalid_parameters",
                    "message": "One or more query parameters are invalid.",
                    "detail": [
                      {
                        "field": "per_page",
                        "reason": "Input should be less than or equal to 100"
                      }
                    ]
                  }
                }
              }
            }
          },
          "401": {
            "description": "The request did not come through RapidAPI.",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "unauthorized",
                    "message": "Missing or invalid X-RapidAPI-Proxy-Secret header."
                  }
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error. Details are logged server-side, never returned.",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "internal_error",
                    "message": "An unexpected error occurred."
                  }
                }
              }
            }
          }
        }
      }
    },
    "/recalls/{agency}/{source_id}": {
      "get": {
        "tags": [
          "recalls"
        ],
        "summary": "Get one recall by agency and source ID",
        "description": "Look up a single recall by the identifier its own agency uses.\n\nThis is the stable, agency-native key — use it to re-fetch a recall you\nhave already seen, rather than the internal `id`, which is not guaranteed\nstable across reloads.\n\nIdentifier formats differ by agency:\n\n| Agency | Format | Example |\n|---|---|---|\n| FDA | `recall_number` | `D-0690-2026` |\n| CPSC | `RecallNumber` | `26636` |\n| NHTSA | NHTSA campaign number | `26V481000` |\n\nIdentifiers containing `/` are accepted as-is and do not need encoding.\n\nReturns `404` if no recall matches that agency and identifier.",
        "operationId": "getRecallById",
        "parameters": [
          {
            "name": "agency",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "Agency code, case-insensitive.",
              "examples": [
                "NHTSA"
              ],
              "title": "Agency"
            },
            "description": "Agency code, case-insensitive."
          },
          {
            "name": "source_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "The agency's own recall identifier, exactly as it appears in `source_id`.",
              "examples": [
                "26V481000"
              ],
              "title": "Source Id"
            },
            "description": "The agency's own recall identifier, exactly as it appears in `source_id`."
          }
        ],
        "responses": {
          "200": {
            "description": "The requested recall.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ItemResponse_Recall_"
                },
                "example": {
                  "data": {
                    "id": 513,
                    "agency": "NHTSA",
                    "source_id": "26V481000",
                    "product": "AMG GLB35 4MATIC; C 300; C 300 4MATIC; CLE 300 4MATIC (+24 more) (2019-2026)",
                    "brand": "MERCEDES-BENZ",
                    "category": "LATCHES/LOCKS/LINKAGES:DOORS:LOCK",
                    "hazard": "The micro-switch in the driver's door lock may corrode and fail to detect an open door, preventing the electronic parking brake from engaging automatically. This may result in a vehicle rollaway.",
                    "classification": "Vehicle",
                    "recall_date": "2026-07-24",
                    "published_at": "2026-07-27T00:00:00Z",
                    "url": "https://www.nhtsa.gov/recalls?nhtsaId=26V481000",
                    "ingested_at": "2026-07-31T04:07:31.164779Z"
                  },
                  "meta": {}
                }
              }
            }
          },
          "404": {
            "description": "No recall matches that agency and source_id.",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "not_found",
                    "message": "No FDA recall with source_id 'H-9999-2099'."
                  }
                }
              }
            }
          },
          "401": {
            "description": "The request did not come through RapidAPI.",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "unauthorized",
                    "message": "Missing or invalid X-RapidAPI-Proxy-Secret header."
                  }
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error. Details are logged server-side, never returned.",
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "internal_error",
                    "message": "An unexpected error occurred."
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
